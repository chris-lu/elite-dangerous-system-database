# Copy to .env and adjust. docker-compose.yml and the importer read these.
POSTGRES_DB=elite_dangerous
POSTGRES_USER=elite_user
POSTGRES_PASSWORD=elite_password
POSTGRES_PORT=5432

# Used by the importer when run on the host (inside compose it is derived automatically).
# Use 127.0.0.1, not localhost: the port is published on IPv4 loopback only and
# an IPv6 (::1) attempt hangs in Docker Desktop's proxy for several seconds.
PG_DSN=postgresql://elite_user:elite_password@127.0.0.1:5432/elite_dangerous
